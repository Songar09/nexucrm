# Copia este archivo a .env (local) o cárgalo como variables de entorno en tu hosting.

# OBLIGATORIO en producción: cadena larga y aleatoria para firmar las sesiones (JWT).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Puerto (los hostings suelen definirlo solos)
PORT=3000

# Ruta del archivo SQLite. En un hosting con disco persistente apunta al disco, ej: /var/data/crm.db
DB_PATH=

# Huso horario para agrupar ventas por día/mes (horas respecto a UTC). Colombia = -5
TZ_OFFSET_HOURS=-5

# 1 = carga datos de demostración la primera vez; 0 = arranca solo con el usuario admin
SEED_DEMO=1

# --- Chatbot con IA (opcional). Sin estas claves el asistente usa respuestas locales. ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Oculta los botones de cuentas demo en el login (se define al compilar): VITE_DEMO_HINT=0
